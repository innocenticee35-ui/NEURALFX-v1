
#property strict
#property version "1.00"
#property description "NEURALFX Demo Market Analyzer"

input double DemoLot = 0.01;
input int FastEMA = 20;
input int SlowEMA = 50;

int fastHandle;
int slowHandle;

int OnInit()
{
   fastHandle = iMA(_Symbol, PERIOD_M15,
                    FastEMA, 0, MODE_EMA, PRICE_CLOSE);

   slowHandle = iMA(_Symbol, PERIOD_M15,
                    SlowEMA, 0, MODE_EMA, PRICE_CLOSE);

   if(fastHandle == INVALID_HANDLE ||
      slowHandle == INVALID_HANDLE)
   {
      Print("NEURALFX: Indicator initialization failed");
      return INIT_FAILED;
   }

   Print("NEURALFX initialized. Analysis only.");

   return INIT_SUCCEEDED;
}

void OnTick()
{
   double fast[];
   double slow[];

   ArraySetAsSeries(fast, true);
   ArraySetAsSeries(slow, true);

   if(CopyBuffer(fastHandle, 0, 0, 2, fast) < 2)
      return;

   if(CopyBuffer(slowHandle, 0, 0, 2, slow) < 2)
      return;

   if(fast[0] > slow[0])
      Comment("NEURALFX: BUY BIAS",
             "\nSymbol: ", _Symbol,
             "\nMode: DEMO ANALYSIS ONLY");

   else if(fast[0] < slow[0])
      Comment("NEURALFX: SELL BIAS",
             "\nSymbol: ", _Symbol,
             "\nMode: DEMO ANALYSIS ONLY");

   else
      Comment("NEURALFX: WAIT",
             "\nMode: DEMO ANALYSIS ONLY");
}

void OnDeinit(const int reason)
{
   IndicatorRelease(fastHandle);
   IndicatorRelease(slowHandle);
   Comment("");
}
